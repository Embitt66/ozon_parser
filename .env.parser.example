# Config for the standalone parser service (app.parser_main), meant to run on
# a machine WITHOUT a VPN so OZON doesn't anti-bot-block requests.
# Copy to .env.parser and fill in.
#
# BOT_TOKEN / DATABASE_URL / REDIS_URL are not used by this service.

# auto (try API, fallback to selenium) | api | selenium
PARSER_MODE=selenium

# Set by docker-compose.parser.yml to point at the selenium sidecar container -
# only override this if you're not using that compose file.
# SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

# Shared secret - must match PARSER_API_KEY in the bot machine's .env.
# Required if this machine's port is reachable from the internet.
PARSER_API_KEY=

WEB_HOST=0.0.0.0
WEB_PORT=8000
