# Telegram
BOT_TOKEN=

# Database
DATABASE_URL=postgresql+asyncpg://ozon:ozon@postgres:5432/ozon_prices

# Redis
REDIS_URL=redis://redis:6379/0

# Parser: auto (try API, fallback to selenium) | api | selenium
# Only used when PARSER_SERVICE_URL below is NOT set (i.e. parsing locally).
PARSER_MODE=auto

# If set, Selenium connects to a remote WebDriver (e.g. selenium/standalone-chrome container).
# Leave empty to launch a local Chrome via webdriver-manager.
# Only used when PARSER_SERVICE_URL below is NOT set.
SELENIUM_REMOTE_URL=http://selenium:4444/wd/hub

# --- Remote parser service (recommended if OZON blocks your VPN's IP) ---
# Run the parser on a separate machine/network without a VPN (see
# docker-compose.parser.yml + .env.parser.example) and point the bot at it here.
# Leave empty to parse locally using PARSER_MODE/SELENIUM_REMOTE_URL above instead.
PARSER_SERVICE_URL=
# Shared secret - must match PARSER_API_KEY in the parser machine's .env.parser.
PARSER_API_KEY=

# Monitoring
DEFAULT_PERCENT_THRESHOLD=20
DEFAULT_CHECK_INTERVAL_SECONDS=300
PRIORITY_CHECK_INTERVAL_SECONDS=1
MAX_CONCURRENT_CHECKS=5
CONFIRM_DELAY_SECONDS=3
SCHEDULER_TICK_SECONDS=1

# Web (health/metrics)
WEB_HOST=0.0.0.0
WEB_PORT=8000
